{
  "info": {
    "name": "POC GraphQL - Users & Orders",
    "description": "GraphQL API (users, orders) plus REST profile image upload.\n\nRun order: Users > Create User first — it saves `userId` into the collection variables. Create Order saves `orderId`. Other requests reuse them.\n\nChange `baseUrl` in the collection Variables tab if the app runs on another host/port. If `spring.graphql.http.path` is changed, update `graphqlPath`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9091"
    },
    {
      "key": "graphqlPath",
      "value": "/graphql"
    },
    {
      "key": "userId",
      "value": "1"
    },
    {
      "key": "orderId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('User created', () => pm.expect(json.data.createUser.success).to.be.true);",
                  "pm.collectionVariables.set('userId', json.data.createUser.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CreateUser($input: UserInput!) {\n  createUser(input: $input) {\n    success\n    message\n    data { id name email }\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"name\": \"{{$randomFullName}}\",\n    \"email\": \"{{$randomEmail}}\"\n  }\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}{{graphqlPath}}",
              "host": [
                "{{baseUrl}}{{graphqlPath}}"
              ]
            }
          }
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query {\n  users {\n    success\n    message\n    data {\n      id\n      name\n      email\n      orders { id product amount }\n    }\n  }\n}",
                "variables": ""
              }
            },
            "url": {
              "raw": "{{baseUrl}}{{graphqlPath}}",
              "host": [
                "{{baseUrl}}{{graphqlPath}}"
              ]
            }
          }
        },
        {
          "name": "Get User By Id",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query GetUser($id: ID!) {\n  user(id: $id) {\n    success\n    message\n    data {\n      id\n      name\n      email\n      profileImage\n      orders { id product amount }\n    }\n  }\n}",
                "variables": "{\n  \"id\": \"{{userId}}\"\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}{{graphqlPath}}",
              "host": [
                "{{baseUrl}}{{graphqlPath}}"
              ]
            }
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation UpdateUser($id: ID!, $input: UserInput!) {\n  updateUser(id: $id, input: $input) {\n    success\n    message\n    data { id name email }\n  }\n}",
                "variables": "{\n  \"id\": \"{{userId}}\",\n  \"input\": {\n    \"name\": \"{{$randomFullName}}\",\n    \"email\": \"{{$randomEmail}}\"\n  }\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}{{graphqlPath}}",
              "host": [
                "{{baseUrl}}{{graphqlPath}}"
              ]
            }
          }
        },
        {
          "name": "Upload Profile Image (REST)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Select a JPEG, PNG or WEBP image (max 2MB)"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}/profile-image",
              "host": [
                "{{baseUrl}}/api"
              ],
              "path": [
                "users",
                "{{userId}}",
                "profile-image"
              ]
            },
            "description": "Body > form-data > key `file` — pick an image file before sending."
          }
        },
        {
          "name": "Remove Profile Image (REST)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}/profile-image",
              "host": [
                "{{baseUrl}}/api"
              ],
              "path": [
                "users",
                "{{userId}}",
                "profile-image"
              ]
            }
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation DeleteUser($id: ID!) {\n  deleteUser(id: $id) {\n    success\n    message\n  }\n}",
                "variables": "{\n  \"id\": \"{{userId}}\"\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}{{graphqlPath}}",
              "host": [
                "{{baseUrl}}{{graphqlPath}}"
              ]
            },
            "description": "Also deletes the user's orders and profile image."
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Order created', () => pm.expect(json.data.createOrder.success).to.be.true);",
                  "pm.collectionVariables.set('orderId', json.data.createOrder.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CreateOrder($input: OrderInput!) {\n  createOrder(input: $input) {\n    success\n    message\n    data {\n      id\n      product\n      amount\n      user { id name }\n    }\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"userId\": \"{{userId}}\",\n    \"product\": \"Laptop\",\n    \"amount\": 55000.50\n  }\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}{{graphqlPath}}",
              "host": [
                "{{baseUrl}}{{graphqlPath}}"
              ]
            }
          }
        },
        {
          "name": "Get All Orders",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query {\n  orders {\n    success\n    message\n    data {\n      id\n      product\n      amount\n      user { id name email }\n    }\n  }\n}",
                "variables": ""
              }
            },
            "url": {
              "raw": "{{baseUrl}}{{graphqlPath}}",
              "host": [
                "{{baseUrl}}{{graphqlPath}}"
              ]
            }
          }
        },
        {
          "name": "Get Order By Id",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query GetOrder($id: ID!) {\n  order(id: $id) {\n    success\n    message\n    data {\n      id\n      product\n      amount\n      user { id name }\n    }\n  }\n}",
                "variables": "{\n  \"id\": \"{{orderId}}\"\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}{{graphqlPath}}",
              "host": [
                "{{baseUrl}}{{graphqlPath}}"
              ]
            }
          }
        },
        {
          "name": "Get Orders By User",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query OrdersByUser($userId: ID!) {\n  ordersByUser(userId: $userId) {\n    success\n    message\n    data { id product amount }\n  }\n}",
                "variables": "{\n  \"userId\": \"{{userId}}\"\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}{{graphqlPath}}",
              "host": [
                "{{baseUrl}}{{graphqlPath}}"
              ]
            }
          }
        },
        {
          "name": "Update Order",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation UpdateOrder($id: ID!, $input: OrderInput!) {\n  updateOrder(id: $id, input: $input) {\n    success\n    message\n    data { id product amount }\n  }\n}",
                "variables": "{\n  \"id\": \"{{orderId}}\",\n  \"input\": {\n    \"userId\": \"{{userId}}\",\n    \"product\": \"Gaming Laptop\",\n    \"amount\": 72000\n  }\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}{{graphqlPath}}",
              "host": [
                "{{baseUrl}}{{graphqlPath}}"
              ]
            }
          }
        },
        {
          "name": "Delete Order",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation DeleteOrder($id: ID!) {\n  deleteOrder(id: $id) {\n    success\n    message\n  }\n}",
                "variables": "{\n  \"id\": \"{{orderId}}\"\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}{{graphqlPath}}",
              "host": [
                "{{baseUrl}}{{graphqlPath}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Error Examples",
      "item": [
        {
          "name": "Validation Error (blank name, bad email)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation {\n  createUser(input: { name: \"\", email: \"not-an-email\" }) {\n    success\n    message\n  }\n}",
                "variables": ""
              }
            },
            "url": {
              "raw": "{{baseUrl}}{{graphqlPath}}",
              "host": [
                "{{baseUrl}}{{graphqlPath}}"
              ]
            }
          }
        },
        {
          "name": "Not Found (user 999999)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query {\n  user(id: 999999) {\n    success\n    message\n  }\n}",
                "variables": ""
              }
            },
            "url": {
              "raw": "{{baseUrl}}{{graphqlPath}}",
              "host": [
                "{{baseUrl}}{{graphqlPath}}"
              ]
            }
          }
        }
      ]
    }
  ]
}
